rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write across Orbit workspace collections for real-time collaboration
    // Compatible with both NextAuth credentials sessions and Google OAuth
    match /updates/{updateId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /members/{memberId} {
      allow read, write: if true;
    }

    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
